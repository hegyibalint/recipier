SUPABASE_URL=https://your-project.supabase.co
# Public browser API key (sb_publishable_...). Copy it from your Supabase
# dashboard under Project Settings → API Keys. Never use a secret or service-role key.
SUPABASE_PUBLISHABLE_KEY=
# The UUID of your application user, not your Supabase dashboard account.
DEMO_USER_ID=
# The pre-registered ChatGPT OAuth client ID. No client secret belongs in this app.
MCP_CLIENT_ID=
# Canonical MCP resource/audience, independent of the Supabase issuer URL.
MCP_RESOURCE_URL=https://recipier.example/mcp
