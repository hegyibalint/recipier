{
  "name": "recipier",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "dev:local": "node scripts/local-dev.mjs",
    "dev:local:auth": "node scripts/local-dev.mjs --auth",
    "build": "react-router build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run check:app",
    "check:app": "react-router typegen && tsc --noEmit",
    "check:frontend": "npm run check:app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:app": "npm test",
    "test:frontend": "npm run test:app"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "jose": "6.2.14",
    "mcp-lite": "0.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.122.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.156.0"
  }
}
