{
  "compilerOptions": {
    // Target ES2022 to support modern JavaScript features available in current browsers
    "target": "ES2022",
    // Include DOM and ESNext type definitions needed for React web development
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    // Use ESNext module system for modern import/export syntax
    "module": "ESNext",
    // Skip type checking of declaration files for better performance
    "skipLibCheck": true,
    // Use bundler module resolution - optimal for Vite
    "moduleResolution": "bundler",
    // Allow importing TS files without extension in development
    "allowImportingTsExtensions": true,
    // Enable importing JSON files as modules
    "resolveJsonModule": true,
    // Ensures each file can be safely transpiled without dependencies on other imports
    "isolatedModules": true,
    // Don't emit output files - Vite handles this
    "noEmit": true,
    // Support React JSX syntax
    "jsx": "react-jsx",
    // Enable all strict type checking options for better code quality
    "strict": true,
    // Report errors on unused local variables
    "noUnusedLocals": false,
    // Report errors on unused parameters in functions
    "noUnusedParameters": true,
    // Report errors for fallthrough cases in switch statements
    "noFallthroughCasesInSwitch": true,
    // Make sure all properties in an object are checked for null or undefined
    "noUncheckedIndexedAccess": true,
    // Set the base directory for resolving non-relative module names
    "baseUrl": ".",
    // Configure path aliases - "@" points to src/ directory as requested
    "paths": {
      "@/*": ["src/*"]
    },
    // Allow default imports from modules with no default export
    "esModuleInterop": true,
    // Allow synthetic default imports
    "allowSyntheticDefaultImports": true,
    // Ensure consistent casing in file names across all operating systems
    "forceConsistentCasingInFileNames": true
  },
  // Only include files in the src directory
  "include": ["src"]
}
